// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FREE
  PRO
}

enum MessageRole {
  USER
  AI
}

enum ProjectCategory {
    GENERAL_PURPOSE             @map("General Purpose")
    ACADEMIC_AND_EDUCATION      @map("Academic & Research")
    PROFESSIONAL_AND_OFFICE     @map("Professional & Office")
    MEDICAL_AND_HEALTH          @map("Medical & Health")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId  String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  imageUrl     String?
  role         UserRole   @default(FREE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projectsCount     Int     @default(0)
  documentsCount    Int     @default(0)
  projects     Project[]
  documents    Document[]
  annotations Annotation[]
}

model Project {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  projectSettings   Json?
  projectCategory   ProjectCategory     @default(GENERAL_PURPOSE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  description       String?

  userId          String      @db.ObjectId
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentCount   Int           @default(0)
  documents       Document[]
  messages        Message[]
  recommendationQns   RecommendedQuestion[]
  documentChunks    DocumentChunk[]
  annotations Annotation[]
}

model Document {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  fileUrl      String      @unique
  fileName     String
  fileType     String
  pages        Int
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  projectId    String      @db.ObjectId
  projectName   String     
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId       String      @db.ObjectId
  user         User        @relation(fields: [userId], references: [id])

  questions    RecommendedQuestion[]
  annotations Annotation[]
  documentChunks    DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  order      Int
  content    String
  summary    String?
  isTable    Boolean  @default(false)
  embedding  Json
  pageNumber Int?
  fileName   String?

  documentId String   @db.ObjectId
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  projectId  String   @db.ObjectId
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([projectId])
  @@index([documentId, pageNumber])
}

model Message {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  role       MessageRole
  content    String
  citations  Json?       
  createdAt  DateTime    @default(now())

  projectId  String      @db.ObjectId
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RecommendedQuestion {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  questionText String
  createdAt    DateTime  @default(now())

  documentId   String    @db.ObjectId
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  projectId    String    @db.ObjectId
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum AnnotationType {
  HIGHLIGHT
  COMMENT
  NOTE
  SHAPE
}

enum ShapeType {
  RECTANGLE
  CIRCLE
  ARROW
  LINE
  FREEHAND
}

model Annotation {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  type      AnnotationType
  pageNumber Int

  // Common content fields
  quote     String?
  note      String?
  color     String?
  payload   Json?

  // Geometry / anchor data for highlights and shapes
  rects     Json?
  shapeType ShapeType?
  points    Json?
  style     Json?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  projectId String         @db.ObjectId
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentId String        @db.ObjectId
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId    String         @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([documentId])
  @@index([userId])
  @@index([documentId, pageNumber])
}